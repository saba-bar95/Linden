# Local: leave Clerk empty to use dev_local_org
# VITE_CLERK_PUBLISHABLE_KEY=pk_test_...
# CLERK_SECRET_KEY=sk_test_...

# Empty DATABASE_URL → local SQLite in ./data/job-margin.sqlite
# Production (Railway / Vercel backup): Neon connection string
# DATABASE_URL=postgresql://...

# Railway
PORT=3001
# Required in production (Railway/Vercel): exact frontend origin — wildcard fails startup
# CORS_ORIGIN=https://your-app.vercel.app
# Browser origins allowed to send Clerk session tokens. Defaults to CORS_ORIGIN.
# CLERK_AUTHORIZED_PARTIES=https://your-app.vercel.app,http://localhost:5173

# Opt-in: refuse to start unless CLERK_SECRET_KEY is sk_live_ (recommended for real prod).
# Staging on Railway with sk_test_ works without this flag.
# CLERK_REQUIRE_LIVE_KEYS=true
# VITE_CLERK_REQUIRE_LIVE_KEYS=true
